---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base
  title="Page Not Found | Nonna Delia's"
  description="This Nonna Delia's page doesn't exist. Head back home, browse the menu, or order pizza and pasta online for pickup or delivery."
  noindex
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p>The link may be old. Everything on the menu is still here.</p>
      <div class="button-row">
        <a class="button button-yellow" href="/">Back to Home</a>
        <a class="button button-outline" href="/menu/">View Menu</a>
        <a class="button button-outline" href={site.orderUrl}>Order Online</a>
      </div>
    </div>
  </section>
</Base>
