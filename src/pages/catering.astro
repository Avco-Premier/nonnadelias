---
import Base from "../layouts/Base.astro";
import MenuSections from "../components/MenuSections.astro";
import menu from "../data/menu.json";
import { site } from "../data/site";

const categories = menu.categories.filter((c) => /catering$/i.test(c.name));
---
<Base
  title="Catering Trays & Party Heros | Nonna Delia's College Point"
  description="Feeding a crowd in College Point or nearby Queens? See Nonna Delia's catering trays, party heros, focaccia, wraps, and salads, then call to plan your order."
  image="/images/grandma-square.jpg"
>
  <section class="page-hero">
    <img src="/images/grandma-square.jpg" alt="" fetchpriority="high" />
    <div class="page-hero-inner">
      <p class="eyebrow">Catering</p>
      <h1>Bring Nonna Delia's to the Table</h1>
      <p>We cater parties of all sizes, from office meetings to family gatherings and special events. Build the spread around pizza, pasta, salads, trays, and Italian comfort food.</p>
      <div class="button-row">
        <a class="button button-yellow" href={`tel:${site.phoneTel}`}>Call to Cater</a>
        <a class="button button-outline" href={site.orderUrl}>Start an Order</a>
      </div>
    </div>
  </section>

  <div class="section">
    <MenuSections categories={categories}>
      <div class="menu-cta">
        <p>Call the restaurant for larger party orders and event planning: <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>.</p>
        <a class="button button-red" href={site.orderUrl}>Start an Order</a>
      </div>
      <p class="menu-note">Prices and availability can change; your online order always shows the current price.</p>
    </MenuSections>
  </div>
</Base>
